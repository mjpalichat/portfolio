<div class="lightbox" id="lightbox" hidden>
  <div class="lightbox-controls">
    <button class="lightbox-icon-btn" id="lightbox-zoom" aria-label="Zoom in" aria-pressed="false">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <circle cx="10.5" cy="10.5" r="6.5"></circle>
        <line x1="15.5" y1="15.5" x2="21" y2="21"></line>
        <line x1="7.5" y1="10.5" x2="13.5" y2="10.5"></line>
        <line x1="10.5" y1="7.5" x2="10.5" y2="13.5"></line>
      </svg>
    </button>
    <button class="lightbox-icon-btn" id="lightbox-fullscreen" aria-label="Enter fullscreen" aria-pressed="false">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="8 3 3 3 3 8"></polyline>
        <polyline points="16 3 21 3 21 8"></polyline>
        <polyline points="3 16 3 21 8 21"></polyline>
        <polyline points="21 16 21 21 16 21"></polyline>
      </svg>
    </button>
    <button class="lightbox-close" id="lightbox-close" aria-label="Close">&times;</button>
  </div>
  <button class="lightbox-prev" id="lightbox-prev" aria-label="Previous image">&#8249;</button>
  <div class="lightbox-frame" id="lightbox-frame"></div>
  <button class="lightbox-next" id="lightbox-next" aria-label="Next image">&#8250;</button>
</div>

<script src="{{ '/assets/js/lightbox.js' | url }}" defer></script>
