<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title or "Matt Palichat" }}</title>
  <!-- M PLUS 2 is Matt's chosen font (weight 500 is what he's styling
       around) - requested as one variable-font range (100..900) rather
       than several static weight files, since the CSS already uses 200,
       400, 500, 700 and 900 across the site (nav emphasis, MV card
       title/credit, etc.) and a range request covers all of them in a
       single download instead of five separate ones. -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=M+PLUS+2:wght@100..900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="{{ '/assets/css/style.css' | url }}">
</head>
{% set navItems = [
  { label: "Narrative", url: "/narrative/" },
  { label: "Documentary", url: "/documentary/" },
  { label: "MV", url: "/mv/" },
  { label: "Design", url: "/design/" },
  { label: "Photo", url: "/photography/" },
  { label: "Music", url: "/music/" },
  { label: "About", url: "/about/" }
] %}
{% set pageOrder = ["/", "/narrative/", "/documentary/", "/mv/", "/design/", "/photography/", "/music/", "/about/"] %}
{% set currentIndex = pageOrder.indexOf(page.url) %}
{% set prevUrl = (pageOrder[currentIndex - 1] | url) if currentIndex > 0 else "" %}
{% set nextUrl = (pageOrder[currentIndex + 1] | url) if (currentIndex > -1 and currentIndex < pageOrder.length - 1) else "" %}
<body data-prev-url="{{ prevUrl }}" data-next-url="{{ nextUrl }}">
  {% if page.url == '/' %}
  <!-- Runs synchronously, before the header below is even parsed, so a
       returning visitor's header/button never visibly flash hidden-then-
       shown - only a first-time visitor (nothing in localStorage yet)
       keeps them hidden for home.js's delayed one-time reveal. -->
  <script>
    try {
      if (localStorage.getItem("introSeen")) document.body.classList.add("chrome-visible");
    } catch (e) {}
  </script>
  {% endif %}

  <header class="site-header" id="site-header">
    <div class="header-left">
      <a class="brand" href="{{ '/' | url }}" aria-label="Matt Palichat">
        <img class="brand-logo" src="{{ '/assets/images/mp-logo.png' | url }}" alt="" width="3000" height="3000">
      </a>
    </div>

    <div class="header-center">
      <!-- Mobile-only full word list, shown in the toggle's full-screen
           overlay (see the max-width:640px media query) - desktop never
           renders this, .compact-nav is its only nav there. The words sit
           inside a drawn circle rather than just floating full-width. -->
      <nav class="site-nav" id="site-nav">
        <div class="site-nav-circle">
          <div class="site-nav-list">
            {% for item in navItems %}
            <a href="{{ item.url | url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.label }}</a>
            {% endfor %}
          </div>
        </div>
      </nav>
      <nav class="compact-nav" aria-label="Page navigation">
        {% for item in navItems %}
        <a class="compact-nav-item" href="{{ item.url | url }}"{% if page.url == item.url %} aria-current="page"{% endif %} aria-label="{{ item.label }}">
          <span class="compact-nav-label">
            <span class="compact-nav-letter{% if page.url == item.url %} is-current{% endif %}">{{ item.label[0] }}</span><span class="compact-nav-rest">{{ item.label.slice(1) }}</span>
          </span>
          <span class="compact-nav-dot{% if page.url == item.url %} is-current{% endif %}"></span>
        </a>
        {% endfor %}
      </nav>
    </div>

    <div class="header-right">
      <a class="contact-link" href="{{ '/contact/' | url }}"{% if page.url == '/contact/' %} aria-current="page"{% endif %}>Contact</a>
    </div>

    <button class="nav-toggle" id="nav-toggle" aria-label="Toggle menu" aria-expanded="false">
      <span class="nav-toggle-dots"><span></span><span></span><span></span></span>
      <span class="nav-toggle-circle"></span>
    </button>
  </header>

  <main>
    {{ content | safe }}
  </main>

  <script src="{{ '/assets/js/nav.js' | url }}" defer></script>
</body>
</html>
