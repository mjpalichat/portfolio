<div class="photo-grid" data-lightbox-gallery>
{% for item in collections.photography %}
  <figure>
    <button class="lightbox-trigger" aria-label="View {{ item.data.alt }} larger">
      {% responsiveImage "./src/content/photography/originals/" + item.data.image, item.data.alt, "photography" %}
    </button>
  </figure>
{% endfor %}
</div>

