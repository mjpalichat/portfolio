---
layout: layouts/base.njk
title: MV — Matt Palichat
permalink: /mv/
---
<div class="mv-grid">
{% for item in collections.mv %}
  <figure class="mv-card">
    <a href="https://www.youtube.com/watch?v={{ item.data.youtube_id }}"
       class="mv-play"
       data-youtube-id="{{ item.data.youtube_id }}"
       aria-label="Play {{ item.data.title }}">
      {% responsiveImage "./src/content/mv/originals/" + item.data.image, item.data.alt, "mv", "(max-width: 700px) 100vw, 50vw" %}
      <figcaption>
        <span class="mv-title">{{ item.data.title }}</span>
        <span class="mv-credit">{{ item.data.credit }}</span>
      </figcaption>
    </a>
  </figure>
{% endfor %}
</div>

<div class="video-modal" id="video-modal" hidden>
  <button class="video-modal-close" id="video-modal-close" aria-label="Close video">&times;</button>
  <div class="video-modal-frame" id="video-modal-frame"></div>
</div>

<script src="/assets/js/mv.js" defer></script>
